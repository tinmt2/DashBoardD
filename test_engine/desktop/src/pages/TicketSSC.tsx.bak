import React, { useState, useEffect, useRef, useMemo } from 'react';
import { useTaskContext } from '../context/TaskContext';
import { ticketApi } from '../api/ticket';
import type { TicketJobState } from '../api/ticket';

const TICKET_TYPES = [
  "Camera MKN", 
  "Lỗi Đầu ghi", 
  "Cam không có playback", 
  "Lỗi ổ cứng"
];

const TicketSSC: React.FC = () => {
  const [filterType, setFilterType] = useState<string>('TẤT CẢ');
  const [searchQuery, setSearchQuery] = useState('');
  
  const { tasks, startTask } = useTaskContext();
  const task = tasks['ticket'];
  const jobId = task?.jobId;
  const jobState = task as any as TicketJobState;
  
  // Track which ticket type is currently running a job
  const [activeJobType, setActiveJobType] = useState<string | null>(null);

  const [ticketData, setTicketData] = useState<Record<string, { total: number, created: number, loading: boolean, error?: string, data: any[] }>>({});
  const [globalLoading, setGlobalLoading] = useState(true);
  
  const [modalState, setModalState] = useState<{
    isOpen: boolean;
    type: 'confirm' | 'success' | 'error';
    title: string;
    message: string;
    onConfirm?: () => void;
  }>({ isOpen: false, type: 'confirm', title: '', message: '' });
  
  const logsEndRef = useRef<HTMLDivElement>(null);

  const countCreated = (data: any[]) => {
    return data.filter(r => {
      const keys = Object.keys(r);
      const ticketKey = keys.find(k => ['ticket', 'ticket id', 'ticket_id'].includes(k.toLowerCase()));
      return ticketKey && r[ticketKey] && r[ticketKey] !== '-' && r[ticketKey] !== '';
    }).length;
  };

  const fetchAllGSheet = async () => {
    setGlobalLoading(true);
    const newState: any = {};
    for (const type of TICKET_TYPES) {
      newState[type] = { total: 0, created: 0, loading: true, data: [] };
    }
    setTicketData(newState);

    for (const type of TICKET_TYPES) {
      try {
        const res = await fetch(`http://127.0.0.1:18020/api/ticket/data?ticket_type=${encodeURIComponent(type)}`);
        const json = await res.json();
        if (json.success) {
           const created = countCreated(json.data);
           setTicketData(prev => ({ ...prev, [type]: { total: json.data.length, created, loading: false, data: json.data } }));
        } else {
           setTicketData(prev => ({ ...prev, [type]: { total: 0, created: 0, loading: false, error: json.message, data: [] } }));
        }
      } catch (err: any) {
           setTicketData(prev => ({ ...prev, [type]: { total: 0, created: 0, loading: false, error: err.message, data: [] } }));
      }
    }
    setGlobalLoading(false);
  };

  const handleDownload = () => {
    if (jobId) {
      window.open(`http://127.0.0.1:18020/api/ticket/download/${jobId}`, '_blank');
    }
  };

  useEffect(() => {
    fetchAllGSheet();
  }, []);

  const isRunning = jobState?.status === 'running' || jobState?.status === 'queued';
  const isCompleted = jobState?.status === 'completed';
  const hasError = jobState?.status === 'failed' || !!jobState?.error;

  const startJob = async (type: string) => {
    if (isRunning) return;
    setActiveJobType(type);
    const res = await ticketApi.createJob(null, type);
    if (res.success && res.data) {
      startTask('ticket', res.data.job_id);
    } else {
      setActiveJobType(null);
      setModalState({ isOpen: true, type: 'error', title: 'Không thể tạo tiến trình', message: res.message || 'Lỗi hệ thống.' });
    }
  };

  const startCheckJob = async (type: string) => {
    if (isRunning) return;
    setActiveJobType(type);
    const res = await ticketApi.checkJob(null, type);
    if (res.success && res.data) {
      startTask('ticket', res.data.job_id);
    } else {
      setActiveJobType(null);
      setModalState({ isOpen: true, type: 'error', title: 'Không thể kiểm tra tiến trình', message: res.message || 'Lỗi hệ thống.' });
    }
  };

  const handleCancel = async () => {
    if (jobId) {
      await ticketApi.cancelJob(jobId);
    }
  };

  useEffect(() => {
    if (logsEndRef.current) {
      logsEndRef.current.scrollIntoView({ behavior: 'smooth' });
    }
  }, [jobState?.logs?.length]);

  // If a job completes or fails, we might want to refresh the data for that type
  // Wait, if we fetch all gsheet on completion, it updates exactly. But the UI is already updated via jobState.results.
  // We can just rely on the jobState.results override logic below.

  // Compute live metrics
  let totalTicketAll = 0;
  let createdTicketAll = 0;

  const typeMetrics = TICKET_TYPES.map(type => {
    let total = ticketData[type]?.total || 0;
    let created = ticketData[type]?.created || 0;
    
    // Override with job state if this type is currently being processed
    const isThisTypeActive = activeJobType === type;
    if (jobState && isThisTypeActive && (isRunning || isCompleted)) {
       total = Math.max(total, jobState.total);
       created = countCreated(jobState.results);
    }
    
    totalTicketAll += total;
    createdTicketAll += created;
    const uncreated = total - created;
    const pct = total > 0 ? Math.round((created / total) * 100) : 0;
    
    // Determine state for THIS type
    let typeState = 'IDLE';
    if (isThisTypeActive) {
      if (isRunning) typeState = 'PROCESSING';
      else if (hasError) typeState = 'ERROR';
      else if (isCompleted) typeState = 'COMPLETED';
    }

    return { type, total, created, uncreated, pct, loading: ticketData[type]?.loading, state: typeState };
  });

  const overallPct = totalTicketAll > 0 ? Math.min((createdTicketAll / totalTicketAll) * 100, 100).toFixed(1) : '0.0';

  const getLogColor = (msg: string) => {
    const lower = msg.toLowerCase();
    if (lower.includes('lỗi') || lower.includes('failed') || lower.includes('error') || lower.includes('thất bại')) return 'text-rose-400';
    if (lower.includes('success') || lower.includes('thành công')) return 'text-emerald-400';
    if (lower.includes('warning') || lower.includes('không tìm thấy')) return 'text-amber-400';
    return 'text-blue-400';
  };

  const getLogBg = (msg: string) => {
    const lower = msg.toLowerCase();
    if (lower.includes('lỗi') || lower.includes('failed') || lower.includes('error') || lower.includes('thất bại')) return 'bg-rose-500/10 border-rose-500/20';
    if (lower.includes('success') || lower.includes('thành công')) return 'bg-emerald-500/10 border-emerald-500/20';
    if (lower.includes('warning') || lower.includes('không tìm thấy')) return 'bg-amber-500/10 border-amber-500/20';
    return 'bg-blue-500/5 border-blue-500/10';
  };

  // Combine data for the table
  const tableData = useMemo(() => {
    let allData: any[] = [];
    TICKET_TYPES.forEach(t => {
      let dataToUse = ticketData[t]?.data || [];
      if (jobState && activeJobType === t && (isRunning || isCompleted)) {
        dataToUse = jobState.results || [];
      }
      
      dataToUse.forEach(item => {
        allData.push({ ...item, _type: t });
      });
    });
    
    if (filterType !== 'TẤT CẢ') {
      allData = allData.filter(d => d._type === filterType);
    }
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      allData = allData.filter(d => Object.values(d).some(v => String(v).toLowerCase().includes(q)));
    }
    
    return allData;
  }, [ticketData, jobState, activeJobType, isRunning, isCompleted, filterType, searchQuery]);


  return (
    <div className="-m-6 h-[calc(100%+3rem)] flex flex-col bg-[#0B1120] text-slate-200 font-sans overflow-hidden relative">
      
      {/* HEADER */}
      <header className="flex justify-between items-center px-10 py-6 shrink-0 z-10 relative bg-slate-950/20 backdrop-blur-md border-b border-slate-800/50">
        <div>
          <h1 className="text-[13px] font-bold tracking-[0.2em] uppercase text-white mb-1">TICKET SSC</h1>
          <div className="text-[10px] font-bold tracking-[0.15em] uppercase text-slate-500">AUTO SYNC WORKSPACE</div>
        </div>
        
        <div className="flex items-center gap-6 text-[10px] font-bold tracking-[0.1em] uppercase">
          {globalLoading ? (
             <div className="px-3 py-1.5 rounded-full border border-blue-500/20 bg-blue-500/10 text-blue-400 flex items-center gap-2">
               <span className="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
               ĐANG ĐỒNG BỘ DỮ LIỆU
             </div>
          ) : (
             <div className="px-3 py-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 text-emerald-400 flex items-center gap-2">
               <span className="w-2 h-2 rounded-full bg-emerald-500"></span>
               DỮ LIỆU ĐÃ ĐỒNG BỘ
             </div>
          )}
        </div>
      </header>
      
      <div className="flex-1 overflow-auto custom-scrollbar flex flex-col relative">
        <div className="absolute top-[20%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-500/5 rounded-full blur-[120px] pointer-events-none"></div>
        
        <div className="p-8 flex-1 flex flex-col min-h-0 z-10">
          
          {/* GLOBAL ACTION ZONE */}
          <div className="mb-8 p-6 bg-slate-900/40 border border-slate-800/50 rounded-xl flex items-center justify-between">
            <div>
              <h2 className="text-sm font-bold tracking-[0.1em] text-white uppercase mb-1">CHECK TẤT CẢ TICKET</h2>
              <p className="text-xs text-slate-400">Kiểm tra đồng thời toàn bộ ticket của 4 nhóm hệ thống</p>
            </div>
            <button
              onClick={() => startCheckJob('ALL')}
              disabled={isRunning}
              className="px-6 py-3 bg-blue-500/20 text-blue-400 hover:bg-blue-500/30 text-xs font-bold tracking-[0.1em] uppercase rounded border border-blue-500/50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"
            >
              {isRunning && activeJobType === 'ALL' ? (
                <>
                  <svg className="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                  ĐANG KIỂM TRA...
                </>
              ) : (hasError && activeJobType === 'ALL') ? 'THỬ LẠI' : (isCompleted && activeJobType === 'ALL') ? 'CHECK LẠI TẤT CẢ' : 'CHECK TẤT CẢ TICKET'}
            </button>
          </div>

          {/* 4 METRICS WORK ZONES */}
          <div className="grid grid-cols-4 gap-8 mb-8">
            {typeMetrics.map((m, i) => (
              <div key={i} className={`bg-slate-900/40 border ${m.state === 'PROCESSING' ? 'border-blue-500/50 shadow-[0_0_20px_rgba(59,130,246,0.15)]' : 'border-slate-800/50'} rounded-xl p-6 backdrop-blur-sm relative overflow-hidden flex flex-col`}>
                 {m.loading && (
                    <div className="absolute inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center z-10">
                      <svg className="w-6 h-6 text-blue-400 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    </div>
                 )}
                 <div className="text-[11px] font-bold tracking-[0.15em] text-white uppercase mb-6 truncate" title={m.type}>{m.type}</div>
                 
                 <div className="space-y-4 mb-6">
                   <div className="flex justify-between items-end">
                     <span className="text-[10px] font-bold tracking-[0.1em] text-slate-500 uppercase">TỔNG TICKET</span>
                     <span className="text-3xl font-light text-white tabular-nums">{m.total.toLocaleString('vi-VN')}</span>
                   </div>
                   <div className="flex justify-between items-end">
                     <span className="text-[10px] font-bold tracking-[0.1em] text-emerald-400/80 uppercase">✓ ĐÃ TẠO</span>
                     <span className="text-2xl font-light text-emerald-400 tabular-nums">{m.created.toLocaleString('vi-VN')}</span>
                   </div>
                   <div className="flex justify-between items-end">
                     <span className="text-[10px] font-bold tracking-[0.1em] text-amber-400/80 uppercase">○ CHƯA TẠO</span>
                     <span className="text-2xl font-light text-amber-400 tabular-nums">{m.uncreated.toLocaleString('vi-VN')}</span>
                   </div>
                   
                   <div className="pt-2">
                     <div className="flex justify-between text-[10px] font-bold tracking-wider mb-1">
                       <span className="text-slate-500 uppercase">PROGRESS</span>
                       <span className="text-blue-400">{m.pct}%</span>
                     </div>
                     <div className="h-1 bg-slate-800 rounded-full overflow-hidden">
                       <div className="h-full bg-blue-500" style={{ width: `${m.pct}%` }}></div>
                     </div>
                   </div>
                 </div>

                 {/* ACTION BUTTONS */}
                 <div className="mt-auto pt-4 border-t border-slate-800/50">
                    {m.state === 'PROCESSING' ? (
                       <div className="flex gap-2">
                         <button disabled className="flex-1 py-3 bg-blue-500/20 text-blue-400 text-[10px] font-bold tracking-wider uppercase rounded shadow border border-blue-500/30 flex items-center justify-center gap-2">
                           <svg className="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                           ĐANG TẠO...
                         </button>
                         <button onClick={handleCancel} className="px-3 py-3 bg-rose-500/10 text-rose-400 border border-rose-500/30 rounded hover:bg-rose-500/20 transition-colors" title="Dừng">
                           <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M6 18L18 6M6 6l12 12"/></svg>
                         </button>
                       </div>
                    ) : m.state === 'ERROR' ? (
                       <button 
                         onClick={() => startJob(m.type)} 
                         disabled={isRunning}
                         className="w-full py-3 bg-rose-500/20 text-rose-400 hover:bg-rose-500/30 text-[10px] font-bold tracking-wider uppercase rounded shadow border border-rose-500/50 transition-colors disabled:opacity-50"
                       >
                         THỬ LẠI ({m.uncreated})
                       </button>
                    ) : m.uncreated > 0 ? (
                       <button 
                         onClick={() => startJob(m.type)} 
                         disabled={isRunning || m.total === 0}
                         className="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white text-[10px] font-bold tracking-wider uppercase rounded shadow-[0_0_15px_rgba(16,185,129,0.2)] transition-colors disabled:opacity-50"
                       >
                         TẠO {m.uncreated} TICKET
                       </button>
                    ) : (
                       <div className="w-full py-3 text-emerald-500/50 text-[10px] font-bold tracking-wider uppercase rounded text-center border border-transparent">
                         HOÀN TẤT
                       </div>
                    )}
                 </div>
              </div>
            ))}
          </div>

          {/* GLOBAL SUMMARY */}
          <div className="mb-8 bg-slate-900/20 border border-slate-800/50 rounded-xl p-6 backdrop-blur-sm">
             <div className="flex justify-between items-end mb-4">
                <div className="flex flex-col">
                  <div className="text-[10px] font-bold tracking-[0.2em] text-slate-500 uppercase mb-1">TỔNG TIẾN ĐỘ TẠO TICKET</div>
                  <div className="text-xs text-slate-400 font-mono">Total: {totalTicketAll.toLocaleString('vi-VN')} | Created: {createdTicketAll.toLocaleString('vi-VN')} | Uncreated: {(totalTicketAll - createdTicketAll).toLocaleString('vi-VN')}</div>
                </div>
                <div className="text-3xl font-light text-white tabular-nums tracking-tight">
                  <span className="text-emerald-400">{createdTicketAll.toLocaleString('vi-VN')}</span>
                  <span className="text-slate-600 mx-2">/</span>
                  <span>{totalTicketAll.toLocaleString('vi-VN')}</span>
                </div>
             </div>
             <div className="h-1 w-full bg-slate-800/80 rounded-full overflow-hidden shadow-inner">
                <div className="h-full bg-blue-500 transition-all duration-500 ease-out relative" style={{ width: `${overallPct}%` }}>
                   <div className="absolute top-0 right-0 bottom-0 left-0 bg-gradient-to-r from-transparent via-white/30 to-transparent -translate-x-full animate-[shimmer_2s_infinite]"></div>
                </div>
             </div>
          </div>
          
          {jobState?.error && (
            <div className="mb-8 px-6 py-4 text-rose-400 text-sm font-medium flex items-center bg-rose-500/10 border border-rose-500/20 rounded-xl shrink-0">
              <svg className="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              {jobState.error.message}
            </div>
          )}

          {/* 2 COLUMNS: LOGS AND RESULTS */}
          <div className="flex-1 flex gap-8 min-h-0">
            
            {/* ACTIVITY LOG */}
            <div className="w-[400px] border border-slate-800/50 bg-slate-900/20 rounded-xl flex flex-col overflow-hidden backdrop-blur-sm shadow-xl">
              <div className="px-6 py-4 border-b border-slate-800/50 flex items-center justify-between bg-slate-950/40">
                <div className="text-[10px] font-bold tracking-[0.15em] text-slate-500 uppercase flex items-center gap-2">
                  <span className={`w-2 h-2 rounded-full ${isRunning ? 'bg-blue-500 animate-pulse' : 'bg-slate-600'}`}></span>
                  ACTIVITY LOG
                </div>
              </div>
              <div className="flex-1 overflow-y-auto p-4 custom-scrollbar space-y-2">
                {(jobState?.logs || []).map((log, i) => (
                  <div key={i} className={`px-4 py-3 rounded-lg border text-xs font-mono leading-relaxed ${getLogBg(log.msg)} ${getLogColor(log.msg)}`}>
                    {log.msg}
                  </div>
                ))}
                {(!jobState?.logs || jobState.logs.length === 0) && <div className="text-slate-600 text-sm p-4 text-center font-mono">Chờ khởi chạy tiến trình...</div>}
                <div ref={logsEndRef} />
              </div>
            </div>

            {/* RESULTS TABLE */}
            <div className="flex-1 flex flex-col bg-slate-900/20 border border-slate-800/50 rounded-xl overflow-hidden backdrop-blur-sm shadow-xl">
              
              <div className="p-4 border-b border-slate-800/50 bg-slate-950/40 flex items-center gap-4">
                {/* TABS */}
                <div className="flex gap-1 p-1 bg-slate-900/80 border border-slate-800/50 rounded-lg">
                  <button 
                    onClick={() => setFilterType('TẤT CẢ')}
                    className={`px-4 py-2 text-[10px] font-bold tracking-wider uppercase rounded-md transition-colors ${filterType === 'TẤT CẢ' ? 'bg-blue-500/20 text-blue-400' : 'text-slate-500 hover:text-slate-300'}`}
                  >
                    TẤT CẢ
                  </button>
                  {TICKET_TYPES.map(t => (
                    <button 
                      key={t}
                      onClick={() => setFilterType(t)}
                      className={`px-4 py-2 text-[10px] font-bold tracking-wider uppercase rounded-md transition-colors ${filterType === t ? 'bg-blue-500/20 text-blue-400' : 'text-slate-500 hover:text-slate-300'}`}
                    >
                      {t}
                    </button>
                  ))}
                </div>

                <div className="flex-1 flex justify-end">
                   <div className="relative">
                     <svg className="w-4 h-4 text-slate-500 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                     <input 
                        type="text" 
                        placeholder="Tìm kiếm..." 
                        value={searchQuery}
                        onChange={e => setSearchQuery(e.target.value)}
                        className="bg-slate-950/80 border border-slate-700/50 text-sm text-white pl-10 pr-4 py-2 rounded-lg outline-none focus:border-blue-500/50 transition-colors placeholder:text-slate-600 w-64"
                      />
                   </div>
                </div>
              </div>

              <div className="flex-1 overflow-auto custom-scrollbar">
                <table className="w-full text-left border-collapse">
                  <thead className="bg-slate-950/90 sticky top-0 z-10 border-b border-slate-800/50">
                    <tr>
                      <th className="px-6 py-4 text-[10px] font-bold tracking-[0.15em] text-slate-500 uppercase whitespace-nowrap">Phân loại</th>
                      {tableData.length > 0 && Object.keys(tableData[0]).filter(k => k !== '_type').map(k => (
                        <th key={k} className="px-6 py-4 text-[10px] font-bold tracking-[0.15em] text-slate-500 uppercase whitespace-nowrap">{k}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-800/50">
                    {tableData.map((r, i) => (
                      <tr key={i} className="hover:bg-slate-800/40 transition-colors cursor-pointer group">
                        <td className="px-6 py-3 text-xs font-medium text-slate-400">{r._type}</td>
                        {Object.keys(r).filter(k => k !== '_type').map(k => {
                          const val = r[k];
                          const isTicket = k.toLowerCase() === 'ticket' || k.toLowerCase() === 'ticket id' || k.toLowerCase() === 'ticket_id';
                          const displayVal = val && val !== '-' && val !== '' ? val : null;
                          return (
                            <td key={k} className={`px-6 py-3 text-sm ${isTicket ? 'font-bold text-blue-400' : 'text-slate-300'}`}>
                               {isTicket ? (displayVal ? displayVal : <span className="text-amber-500/50">- Chưa tạo</span>) : (displayVal || '-')}
                            </td>
                          );
                        })}
                      </tr>
                    ))}
                    {tableData.length === 0 && (
                      <tr>
                        <td colSpan={10} className="px-6 py-8 text-center text-sm text-slate-500">Chưa có dữ liệu</td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
              <div className="px-6 py-3 border-t border-slate-800/50 bg-slate-950/40 flex justify-between items-center text-[10px] font-bold tracking-wider text-slate-500">
                <div>Hiển thị {tableData.length} kết quả</div>
                {isCompleted && jobState?.output_file?.available && (
                   <button 
                     onClick={handleDownload}
                     className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded transition-colors"
                   >
                     XUẤT EXCEL
                   </button>
                )}
              </div>
            </div>

          </div>
        </div>
      </div>

      {/* MODAL OVERLAY */}
      {modalState.isOpen && (
        <div className="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 animate-in fade-in duration-200">
          <div className="bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl w-full max-w-sm p-8 flex flex-col items-center text-center animate-in zoom-in-95 duration-200">
            {modalState.type === 'confirm' && (
               <div className="w-16 h-16 rounded-full bg-blue-500/10 flex items-center justify-center mb-6 border border-blue-500/20 shadow-[0_0_20px_rgba(59,130,246,0.1)]">
                 <svg className="w-8 h-8 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
               </div>
            )}
            {modalState.type === 'success' && (
               <div className="w-16 h-16 rounded-full bg-emerald-500/10 flex items-center justify-center mb-6 border border-emerald-500/20 shadow-[0_0_20px_rgba(16,185,129,0.1)]">
                 <svg className="w-8 h-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/></svg>
               </div>
            )}
            {modalState.type === 'error' && (
               <div className="w-16 h-16 rounded-full bg-rose-500/10 flex items-center justify-center mb-6 border border-rose-500/20 shadow-[0_0_20px_rgba(244,63,94,0.1)]">
                 <svg className="w-8 h-8 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
               </div>
            )}
            <h3 className="text-xl font-bold text-white mb-2 tracking-tight">{modalState.title}</h3>
            <p className="text-[13px] text-slate-400 mb-8 font-medium leading-relaxed">{modalState.message}</p>
            <div className="flex w-full gap-3">
              {modalState.type === 'confirm' ? (
                <>
                  <button onClick={() => setModalState(prev => ({...prev, isOpen: false}))} className="flex-1 px-4 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 transition-all font-semibold">Hủy</button>
                  <button onClick={() => { setModalState(prev => ({...prev, isOpen: false})); modalState.onConfirm?.(); }} className="flex-1 px-4 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white transition-all font-semibold shadow-[0_0_15px_rgba(16,185,129,0.3)]">Xác nhận</button>
                </>
              ) : (
                <button onClick={() => setModalState(prev => ({...prev, isOpen: false}))} className="flex-1 px-4 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white transition-all font-semibold">Đóng</button>
              )}
            </div>
          </div>
        </div>
      )}

    </div>
  );
};

export default TicketSSC;
